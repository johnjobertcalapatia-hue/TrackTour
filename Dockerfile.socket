# TrackTour Socket.IO realtime engine — Railway build.
# Long-lived process: socket-server.js binds SOCKET_PORT (default 3001) for the
# browser-facing Socket.IO traffic and SOCKET_BRIDGE_PORT (default 3002) for the
# Laravel→socket HTTP dispatch bridge.
#
# Railway service setup: Root Directory = repo root, Dockerfile Path =
# Dockerfile.socket. Expose both ports (public for 3001, internal for 3002).

FROM node:22-alpine

WORKDIR /app

ENV NODE_ENV=production
ENV SOCKET_PORT=3001
ENV SOCKET_BRIDGE_PORT=3002

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY socket-server.js socket-validation.js socket-token.js socket-events.js ./

EXPOSE 3001 3002

CMD ["node", "socket-server.js"]