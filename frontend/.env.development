# TrackTour frontend — DEVELOPMENT
# Loaded automatically by the Vite dev server (`vite` / `npm run dev`).

# Local Socket.IO dispatch engine (socket-server.js → SOCKET_PORT=3001).
VITE_SOCKET_URL=http://localhost:3001

# Empty → relative `/api` base URL, proxied to XAMPP Apache by vite.config.ts.
VITE_API_URL=
