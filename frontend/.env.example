# TrackTour frontend — Vercel build environment
# Set these as env vars on the Vercel project (Settings → Environment Variables).
# Values below are the local-development defaults.

# Absolute public URL of the Laravel API (Railway). The Sentry of every API call.
# Leave empty in local dev (falls back to relative /api via the Vite proxy).
VITE_API_URL=

# Absolute public URL of the Socket.IO server (Railway, port 3001).
VITE_SOCKET_URL=http://localhost:3001

# PayMongo public key (browser-safe).
VITE_PAYMONGO_PUBLIC_KEY=

# Optional: absolute origin used to build /storage/* asset URLs
# (defaults to VITE_API_URL).
VITE_API_ORIGIN=