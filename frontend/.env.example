# TrackTour frontend — Railway image build environment
# Set these build arguments on the Railway frontend service. Values below are
# the local-development defaults.

# Absolute Laravel API base URL, including its /api prefix, e.g.
# https://<your-api-service>.up.railway.app/api.
# Leave empty only in local dev (falls back to relative /api via the Vite
# proxy). Image builds MUST set it: the production Nginx config has no /api
# proxy, so a relative /api in a deployed bundle would return the SPA shell.
VITE_API_URL=

# Absolute public URL of the Socket.IO server (Railway, port 3001).
VITE_SOCKET_URL=http://localhost:3001

# PayMongo public key (browser-safe).
VITE_PAYMONGO_PUBLIC_KEY=

# Optional: absolute API origin used to build /storage/* asset URLs, without
# the /api suffix, e.g. https://<your-api-service>.up.railway.app.
# Defaults to VITE_API_URL with a trailing /api removed.
VITE_API_ORIGIN=