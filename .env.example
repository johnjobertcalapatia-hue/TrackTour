APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# P11.1 Tourism Office share of each COD restaurant settlement (percent)
COD_PLATFORM_FEE_PERCENT=20

# PayMongo
PAYMONGO_SECRET_KEY=sk_test_your_secret_key_here
PAYMONGO_PUBLIC_KEY=pk_test_your_public_key_here
PAYMONGO_WEBHOOK_SECRET=whsk_your_webhook_secret_here
PAYMONGO_BASE_URL=https://api.paymongo.com/v1
VITE_PAYMONGO_PUBLIC_KEY=pk_test_your_public_key_here

# Real-time WebSocket dispatch engine (socket-server.js)
SOCKET_PORT=3001
SOCKET_BRIDGE_PORT=3002
SOCKET_SERVER_URL=http://127.0.0.1:3002
# Shared secret for the Laravel <-> socket HTTP bridge. Must match the value
# loaded by socket-server.js. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SOCKET_BRIDGE_SECRET=
# HMAC trip-token lifetime (seconds) minted by TripTokenService for authorized
# trip-room joins; bounds how long a participant may reconnect into the room.
SOCKET_TRIP_TOKEN_TTL_SECONDS=7200
# Socket engine tuning: minimum interval between a rider's accepted location
# fixes (ms), and how long a pending dispatch stays in RAM before expiring (ms).
SOCKET_LOCATION_MIN_INTERVAL_MS=1000
SOCKET_PENDING_TRIP_TTL_MS=120000

# =============================================================================
# Deployment (Railway backend + Vercel frontend) — see docs/DEPLOYMENT.md
# =============================================================================

# Public URL of the deployed React frontend (Vercel). Used for CORS
# (config/cors.php allowed_origins), SANCTUM_STATEFUL_DOMAINS, and any
# redirect/return links Laravel builds.
# e.g. FRONTEND_URL=https://tracktour.vercel.app

# Stateful (cookie/session) domains for Sanctum, comma-separated. Bearer-token
# auth works without this, but include the Vercel host anyway.
# e.g. SANCTUM_STATEFUL_DOMAINS=tracktour.vercel.app,localhost:3000

# On Railway the Laravel app runs behind their proxy in HTTPS. Laravel's
# HandleInertia/TrustProxies defaults already honour X-Forwarded-Proto, but
# APP_URL must be the canonical https://<service>.up.railway.app address so
# generated URLs (PayMongo return/webhook, email links) are correct.
# APP_ENV=production
# APP_DEBUG=false

# Railway variables this container expects at runtime:
#   APP_KEY, APP_URL, FRONTEND_URL, SANCTUM_STATEFUL_DOMAINS
#   DB_CONNECTION=mysql, DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD
#   PAYMONGO_SECRET_KEY, PAYMONGO_PUBLIC_KEY, PAYMONGO_WEBHOOK_SECRET
#   SOCKET_SERVER_URL  (socket bridge HTTP URL, port 3002)
#   SOCKET_BRIDGE_SECRET (must match the Socket.IO service)
#   QUEUE_CONNECTION=database, SESSION_DRIVER=database, CACHE_STORE=database
#
# MySQL source on Railway: set DB_HOST/DB_PORT/DB_DATABASE/DB_USERNAME/
# DB_PASSWORD from the Railway MySQL plugin's service variables.
