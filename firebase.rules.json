{
  "rules": {
    "live_locations": {
      "$guideId": {
        ".read": "root.child('assignments').child($guideId).hasChild(auth.uid) || root.child('business_guides').child(auth.token.business_id).hasChild($guideId) || auth.token.role === 'super_admin'",
        ".write": "auth.uid === $guideId || auth.token.role === 'super_admin'",
        ".validate": "newData.hasChildren(['lat', 'lng', 'ts']) && newData.child('lat').isNumber() && newData.child('lng').isNumber() && newData.child('ts').isNumber()"
      }
    },
    "active_trips": {
      "$tripId": {
        ".read": "data.child('guide').val() === auth.uid || data.child('tourist').val() === auth.uid || root.child('business_trips').child(auth.token.business_id).hasChild($tripId) || auth.token.role === 'super_admin' || auth.token.role === 'tourism_office'",
        ".write": "auth.token.role === 'super_admin' || (newData.exists() && newData.hasChildren(['guide', 'tourist', 'status']) && newData.child('guide').val() === auth.uid)",
        ".validate": "newData.hasChildren(['guide', 'tourist', 'status'])"
      }
    },
    "rider_requests": {
      "$riderId": {
        "$deliveryId": {
          ".read": "auth.uid === $riderId || auth.token.role === 'super_admin'",
          ".write": "auth.token.role === 'super_admin' || (newData.exists() && newData.hasChildren(['deliveryId', 'status', 'expiresAt']) && newData.child('status').val() === 'pending')"
        }
      }
    },
    "booking_requests": {
      "$deliveryId": {
        ".read": "data.child('tourist').val() === auth.uid || data.child('rider').val() === auth.uid || auth.token.role === 'super_admin'",
        ".write": "auth.token.role === 'super_admin' || (newData.exists() && newData.hasChildren(['rider', 'status']) && (newData.child('status').val() === 'accepted' || newData.child('status').val() === 'declined'))"
      }
    },
    "business_guides": {
      "$businessId": {
        ".read": "auth.token.business_id === $businessId || auth.token.role === 'super_admin'",
        ".write": "auth.token.role === 'super_admin'"
      }
    },
    "business_trips": {
      "$businessId": {
        ".read": "auth.token.business_id === $businessId || auth.token.role === 'super_admin'",
        ".write": "auth.token.role === 'super_admin'"
      }
    },
    "assignments": {
      "$guideId": {
        ".read": "auth.token.role === 'super_admin' || auth.token.role === 'tourism_office' || $guideId === auth.uid",
        ".write": "auth.token.role === 'super_admin'"
      }
    },
    "tourist_trips": {
      "$touristId": {
        ".read": "auth.uid === $touristId || auth.token.role === 'super_admin'",
        ".write": "auth.token.role === 'super_admin'"
      }
    }
  }
}